{
  "name": "pdoom-live",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/db"
  ],
  "scripts": {
    "dev": "npm run dev -w @pdoom/web",
    "build": "npm run build -w @pdoom/web",
    "start": "npm run start -w @pdoom/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/db/src/cli.ts seed",
    "db:reset": "tsx packages/db/src/cli.ts reset",
    "db:validate": "tsx packages/db/src/cli.ts validate",
    "db:import": "tsx packages/db/src/cli.ts import",
    "db:status": "tsx packages/db/src/cli.ts status",
    "data:export": "tsx packages/db/src/cli.ts export",
    "contracts:schema": "tsx packages/contracts/src/emit-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
