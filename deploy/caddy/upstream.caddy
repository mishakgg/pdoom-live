reverse_proxy web:3000 {
	header_up Host {host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
	transport http {
		dial_timeout 3s
		read_timeout 30s
		write_timeout 30s
	}
	health_uri /api/ready
	health_interval 5s
	health_timeout 3s
	health_status 200
	fail_duration 5s
	max_fails 1
	unhealthy_status 503
	lb_retries 0
	lb_try_duration 1s
}
