{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 120s
		}
		max_header_size 16KB
	}
}

www.pdoom.live {
	redir https://pdoom.live{uri} permanent
}

pdoom.live {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		-Server
	}
	import /etc/caddy/state/upstream.caddy
}
