      "execution_status": "unexecuted",
      "input": {
        "work": "W_SYNTHETIC_1",
        "locations": [
          {
            "id": "repo-v2",
            "rights": "CC-BY-4.0",
            "rights_binding": "exact v2",
            "source_policy": "permitted"
          },
          {
            "id": "publisher",
            "rights": null
          }
        ],
        "cached_pdf_available": true,
        "cached_pdf_exact_edition": null
      },
      "expected_output": {
        "raw_candidates_eligible": [
          "repo-v2"
        ],
        "held": [
          "publisher",
          "cached PDF"
        ],
        "public_rights_eligible": [
          "repo-v2 with attribution"
        ],
        "publication_authorized": false,
        "full_work_cleared": false,
        "reason": "Do not propagate a location grant to another copy; cache availability is not identity or permission."
      },
      "rationale_evidence_ids": [
        "OAX-E01",
        "OAX-E04",
        "OAX-E06"
      ]
