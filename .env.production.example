# Install outside the checkout, then replace every CHANGE_ME:
#   sudo install -d -o "$USER" -g "$USER" -m 0750 /etc/pdoom
#   umask 077
#   cp .env.production.example /etc/pdoom/production.env
#   chmod 600 /etc/pdoom/production.env
# Release scripts read PDOOM_ENV_FILE, which defaults to /etc/pdoom/production.env.
# Do not use $, backticks, or command substitution. Compose and the checker reject them.
# Do not commit this file after filling it in, and do not put API keys or private keys here.

NODE_ENV=production
PDOOM_ENV=production
APP_BASE_URL=https://pdoom.live
PDOOM_WEB_IMAGE=pdoom-live:current

POSTGRES_USER=pdoom
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pdoom_live
DATABASE_URL=postgresql://pdoom:CHANGE_ME@postgres:5432/pdoom_live

ACME_EMAIL=ops@example.com

# Optional identity passed into the web container. The release script sets these.
# GIT_COMMIT=
# BUILD_TIME=

# Backup directory on the host. Copy completed backups off this VM.
PDOOM_BACKUP_DIR=/var/lib/pdoom/backups
PDOOM_BACKUP_KEEP_DAILY=14
PDOOM_BACKUP_KEEP_WEEKLY=8
# Optional executable path. It receives the backup directory and manifest path.
# PDOOM_BACKUP_HOOK=/usr/local/sbin/pdoom-backup-sync

# Minimum free space, in MiB, required on the backup filesystem before a release.
PDOOM_MIN_FREE_MB=1024
