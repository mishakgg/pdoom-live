# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Canonical database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdoom_live

# Optional model extraction. Keep real keys out of the repository.
OPENAI_API_KEY=

# Collector identity/configuration
COLLECTOR_USER_AGENT=pdoom.live research collector (development)
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=10000000

# Optional source API credentials are added only when an adapter needs them.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
