# Application
NODE_ENV=development
# production | development | test. Required in production, together with NODE_ENV=production.
PDOOM_ENV=development
# Public origin, no path and no credentials. https enables HSTS. http does not.
APP_BASE_URL=http://localhost:3000
# Optional: on | off. Defaults to on only when APP_BASE_URL is https.
# PDOOM_HSTS=off
# Optional directory of SQL migrations. The production image sets this to /app/migrations.
# PDOOM_MIGRATIONS_DIR=

# Canonical database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdoom_live
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdoom_live_test

# Optional model extraction. Keep real keys out of the repository.
OPENAI_API_KEY=

# Collector identity/configuration
COLLECTOR_USER_AGENT=pdoom.live research collector (development)
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=10000000

# Optional source API credentials are added only when an adapter needs them.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
